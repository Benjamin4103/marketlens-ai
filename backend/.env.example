# === App ===
APP_NAME=MarketLens AI
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-in-production
API_V1_PREFIX=/api

# === Demo Mode ===
# When true, the app uses realistic sample data instead of calling paid APIs.
# Flip to false once OPENAI_API_KEY / SEARCH_API_KEY / NEWS_API_KEY are set.
DEMO_MODE=true

# === Database ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/marketlens
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/marketlens

# === Redis / Celery ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === AI Provider (provider-agnostic; OpenAI used by default) ===
LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# === Research APIs (optional — falls back to demo mode if unset) ===
SEARCH_API_PROVIDER=tavily
SEARCH_API_KEY=
NEWS_API_KEY=

# === Auth ===
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256

# === CORS ===
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
